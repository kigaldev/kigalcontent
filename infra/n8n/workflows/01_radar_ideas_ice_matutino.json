        "url": "https://autonomous-content-engine-backend-production.up.railway.app/api/v1/scripts/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"project_id\": \"{{ $json.id }}\",\n  \"duration_preset\": \"STANDARD_SHORT\",\n  \"conversion_goal\": \"EMAIL_LEAD_CAPTURE\",\n  \"wpm_rate\": 140\n}",
        "options": {}
