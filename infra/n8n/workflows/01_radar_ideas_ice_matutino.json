        "url": "https://autonomous-content-engine-backend-production.up.railway.app/api/v1/projects",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"working_title\": \"{{ $json.concept_title || 'Idea Automática IA Local' }}\",\n  \"target_duration\": \"STANDARD_SHORT\",\n  \"conversion_goal\": \"EMAIL_LEAD_CAPTURE\"\n}",
        "options": {}
      },
      "id": "http-create-project",
      "name": "Crear Proyecto en Studio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 220]
    },
    {
