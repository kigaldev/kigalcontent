    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://autonomous-content-engine-backend-production.up.railway.app/api/v1/ideas/radar-matutino",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"concept_title\": \"Cómo automatizar la creación de contenido con IA local en MiniPC\",\n  \"context_notes\": \"Radar Matutino: Modelos abiertos Qwen3 y DeepSeek optimizados para MiniPCs de 24GB. Permite orquestar guiones, voces y edición sin cuotas de suscripción mensuales.\",\n  \"source_origin\": \"radar_matutino\",\n  \"source_url\": \"https://news.ycombinator.com\",\n  \"target_platforms\": [\"YouTube\", \"Instagram\", \"TikTok\", \"LinkedIn\", \"X\"],\n  \"target_duration\": \"STANDARD_SHORT\",\n  \"conversion_goal\": \"EMAIL_LEAD_CAPTURE\",\n  \"auto_evaluate_ai\": true,\n  \"auto_create_project\": false\n}",
        "options": {}
      },
      "id": "http-eval-ice",
      "name": "Radar Matutino Ingest & AI ICE",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.ice_score }}",
              "operation": "largerEqual",
              "value2": 7
            }
          ]
        }
      },
      "id": "if-ice-alto",
      "name": "¿ICE >= 7.0?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
