{
  "name": "02 - Ingesta Automática desde Google Drive y Procesado FFmpeg (-14 LUFS)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ace-drive-ingest",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-drive",
      "name": "Webhook Nueva Grabación",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ACE_BACKEND_API || 'https://autonomous-content-engine-backend-production.up.railway.app/api/v1' }}/media/google-drive/scan",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"folder_url_or_id\": \"{{ $json.body.folder_url_or_id || 'TU_FOLDER_ID_AQUI' }}\"\n}",
        "options": {}
      },
      "id": "http-scan-drive",
      "name": "Escanear Carpeta Google Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ACE_BACKEND_API || 'https://autonomous-content-engine-backend-production.up.railway.app/api/v1' }}/media/google-drive/import",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"project_id\": \"{{ $('Webhook Nueva Grabación').item.json.body.project_id }}\",\n  \"file_url_or_id\": \"{{ $json.files[0].file_id }}\",\n  \"auto_process\": true\n}",
        "options": {}
      },
      "id": "http-import-process",
      "name": "Importar + FFmpeg R128 + Whisper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook Nueva Grabación": {
      "main": [
        [
          {
            "node": "Escanear Carpeta Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Escanear Carpeta Google Drive": {
      "main": [
        [
          {
            "node": "Importar + FFmpeg R128 + Whisper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "Autonomous Content Engine"
    }
  ]
}
