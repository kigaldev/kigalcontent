{
  "name": "06 - Radar Diario de Reels Virales (Inspiración del Tema del Día)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24,
              "triggerAtHour": 8,
              "triggerAtMinute": 15
            }
          ]
        }
      },
      "id": "cron-reels-matutino",
      "name": "Cada Mañana 08:15",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://autonomous-content-engine-backend-production.up.railway.app/api/v1/projects",
        "options": {
          "timeout": 15000
        }
      },
      "id": "http-read-radar-projects",
      "name": "Leer Proyectos del Flujo 01",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map((i) => i.json).filter(Boolean);\nconst radarProjects = items\n  .filter((p) => p.source_origin === 'radar_matutino')\n  .filter((p) => !String(p.context_notes || '').includes('REELS VIRALES DE INSPIRACIÓN'))\n  .sort((a, b) => new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime())\n  .slice(0, 2);\n\nreturn radarProjects.map((p) => ({\n  json: {\n    project_id: p.id,\n    topic: p.working_title,\n    limit: 5,\n  },\n}));\n"
      },
      "id": "code-pick-radar-topics",
      "name": "Extraer Temas del Día (Sin Reels aún)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://autonomous-content-engine-backend-production.up.railway.app/api/v1/radar/reels-inspiration",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 180000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 2000
            }
          }
        }
      },
      "id": "http-search-top-reels",
      "name": "Buscar Top Reels Virales y Adjuntar al Kanban",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 300]
    }
  ],
