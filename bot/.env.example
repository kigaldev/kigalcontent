# Variables de entorno del bot (en Vercel › Settings › Environment Variables, entorno Production).
# En local: copia como .env.local. Nunca en git ni en el chat.

# "Instagram app secret": el de la sección de Instagram de la app de Meta, NO el secreto general de la app.
IG_APP_SECRET=
# Token de verificación del webhook: lo inventas tú y lo pegas igual en el panel de Meta.
IG_VERIFY_TOKEN=
# Versión de la API (graph.instagram.com)
IG_API_VERSION=v27.0

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lo manda Vercel Cron como "Authorization: Bearer <CRON_SECRET>"; también lo usa el reloj de 5 min de Supabase.
CRON_SECRET=
