# Copia como proyectos/<proyecto>/.env. Un fichero por cuenta de Instagram.
# Token de "Configuración de la API con inicio de sesión de Instagram" › Generar token (ver meta/README.md, paso 3).
IG_TOKEN=
# Lo rellena solo `node meta/ig.mjs whoami --proyecto <proyecto>`
IG_USER_ID=
# Lo actualiza solo la renovación del token
IG_TOKEN_REFRESHED_AT=
