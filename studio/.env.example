# Copia este fichero como .env en la raíz del estudio. Nunca lo subas a git ni pegues valores en el chat.
# Lo que es de una cuenta de Instagram concreta va en proyectos/<proyecto>/.env (ver proyectos/_plantilla/.env.example).

# Alojamiento temporal para que Instagram descargue cada fichero al publicar (se borra justo después).
# Vercel › Storage › Create › Blob (acceso público) › .env.local › BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# Versión de la API de Instagram (graph.instagram.com)
IG_API_VERSION=v27.0

# Bot de comentarios (bot/): solo para los scripts locales ..\bot\scripts\cuenta.mjs y regla.mjs
# (mismo proyecto Supabase que kigalcontent: el de DATABASE_URL).
# Supabase › Project Settings › API. La service_role key no sale nunca de este .env ni de Vercel.
BOT_SUPABASE_URL=
BOT_SUPABASE_SERVICE_ROLE_KEY=

# Opcionales
# APIFY_TOKEN=        # HookLab: analizar reels por URL (de pago por ejecución)
# GEMINI_API_KEY=     # Motion Architect: "ver" vídeos de referencia
# GROQ_API_KEY=       # Motion Architect: transcribir
