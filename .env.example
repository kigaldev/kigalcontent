# Autonomous Content Engine - Environment Template
APP_ENV=development
APP_NAME="Autonomous Content Engine"
API_V1_PREFIX=/api/v1

# Security & HITL HMAC Signing
HITL_HMAC_SECRET=change-this-256-bit-production-hmac-secret-key
JWT_SECRET_KEY=change-this-jwt-signing-key

# PostgreSQL 16 + pgvector (use sqlite+aiosqlite:///./ace_local.db for standalone local dev)
POSTGRES_USER=ace_user
POSTGRES_PASSWORD=ace_secret_password
POSTGRES_DB=autonomous_content_engine
DATABASE_URL=sqlite+aiosqlite:///./ace_local.db

# Redis 7
REDIS_URL=redis://localhost:6379/0

# Temporal.io
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=content-engine-pipeline

# S3 / Cloudflare R2 / LocalStack
S3_ENDPOINT_URL=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET_NAME=ace-media-vault
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# AI & Media Processing
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
ANTHROPIC_API_KEY=
BRAVE_API_KEY=

# Social OAuth2 Connectors
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
