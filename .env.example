# ==============================================================================
# AUTONOMOUS CONTENT ENGINE — VARIABLES DE ENTORNO Y CREDENCIALES
# ==============================================================================
# Este archivo contiene todas las variables del sistema.
# Para producción en Vercel o Railway, solo copia los valores que correspondan.
# Si dejas alguna vacía, el sistema usará automáticamente el modo seguro Sandbox.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (SUPABASE POSTGRESQL 16 + PGVECTOR)
# ------------------------------------------------------------------------------
# Dónde conseguirla: https://supabase.com -> Tu Proyecto -> Project Settings -> Database -> Connection String (URI / Mode Session o Transaction)
# Ejemplo: postgresql://postgres.xxxx:[TU-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:[TU_PASSWORD]@[TU_HOST_SUPABASE]:5432/postgres"

# ------------------------------------------------------------------------------
# 2. ALMACENAMIENTO DE VIDEO (CLOUDFLARE R2 - $0 EGRESO)
# ------------------------------------------------------------------------------
# Dónde conseguirlo: Cloudflare Dashboard -> R2 Object Storage -> Crear Bucket -> Manage R2 API Tokens
# S3_ENDPOINT_URL: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET_NAME: el nombre del bucket que creaste (ej. ace-media-vault)
# AWS_ACCESS_KEY_ID: Token Access Key ID de Cloudflare R2
# AWS_SECRET_ACCESS_KEY: Secret Access Key de Cloudflare R2
S3_ENDPOINT_URL="https://[TU_CLOUDFLARE_ACCOUNT_ID].r2.cloudflarestorage.com"
S3_BUCKET_NAME="ace-media-vault"
AWS_ACCESS_KEY_ID="[TU_CLOUDFLARE_R2_ACCESS_KEY_ID]"
AWS_SECRET_ACCESS_KEY="[TU_CLOUDFLARE_R2_SECRET_KEY]"
S3_REGION="auto"

# ------------------------------------------------------------------------------
# 3. CACHÉ Y RATE-LIMITING (UPSTASH REDIS - SERVERLESS GRATIS)
# ------------------------------------------------------------------------------
# Dónde conseguirlo: https://console.upstash.com -> Create Database -> Redis -> REST / Node Connection URL
# Ejemplo: rediss://default:[PASSWORD]@[HOST].upstash.io:6379
REDIS_URL="rediss://default:[TU_UPSTASH_PASSWORD]@[TU_UPSTASH_HOST].upstash.io:6379"

# ------------------------------------------------------------------------------
# 4. INGESTA DESDE GOOGLE DRIVE (OPCIONAL)
# ------------------------------------------------------------------------------
# Dónde conseguirla: Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> API Key
# Permite escanear y descargar videos directamente desde enlaces de Google Drive.
GOOGLE_DRIVE_API_KEY=""

# ------------------------------------------------------------------------------
# 5. SEGURIDAD Y TOKENS HITL (CRIPTO HMAC SHA-256)
# ------------------------------------------------------------------------------
# Clave aleatoria de 32 caracteres para firmar las autorizaciones de publicación
HITL_HMAC_SECRET="ace-prod-security-secret-change-this-to-any-random-string-32-chars"
JWT_SECRET_KEY="ace-jwt-secret-change-this"

# ------------------------------------------------------------------------------
# 6. REDES SOCIALES (OPCIONALES - SI SE DEJAN VACÍAS ACTÚA EN MODO SANDBOX)
# ------------------------------------------------------------------------------
# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_ACCESS_TOKEN=""

# Instagram Reels (Meta for Developers -> Graph API v21)
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# TikTok Content Posting API v2 (TikTok for Developers)
TIKTOK_ACCESS_TOKEN=""

# LinkedIn Community API (LinkedIn Developers)
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_PERSON_URN="urn:li:person:creator-001"
